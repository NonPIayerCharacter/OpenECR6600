ifeq ($(CONFIG_LCD),y)
    CSRCS += lcd_core.c
    CSRCS += lcd_probe.c
    CSRCS += lcd_bus_spi.c

    ifeq ($(CONFIG_LCD_ST7789),y)
        CSRCS += st7789/st7789.c
    endif

    ifeq ($(CONFIG_LCD_ST77916),y)
        CSRCS += st77916/st77916.c
    endif

    VPATH += :drivers/lcd
    VPATH += :drivers/lcd/st7789
    VPATH += :drivers/lcd/st77916
    INCPATHS += drivers/lcd
    INCPATHS += drivers/lcd/st7789
    INCPATHS += drivers/lcd/st77916
endif

