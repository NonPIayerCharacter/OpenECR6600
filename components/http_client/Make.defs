ifeq ($(CONFIG_HTTP_CLIENT),y)
    CSRCS += http_event.c http_general.c http_interceptor.c http_message_buffer.c
    CSRCS += http_request.c http_response.c http_url_parser.c http_utils.c httpclient.c
    CSRCS += http_parser.c
    CSRCS += nettype_tcp.c nettype_tls.c network.c
    CSRCS += platform_memory.c platform_net_socket.c platform_thread.c platform_timer.c

    VPATH += :http_client/common http_client/httpclient http_client/network http_client/platform/FreeRTOS http_client/libhttp

    INCPATHS += http_client/common http_client/httpclient http_client/network http_client/platform/FreeRTOS http_client/libhttp
endif
