
ifeq ($(CONFIG_WEB_SOCKET_CLIENT),y)
	CSRCS += websocket_client.c
	VPATH += :websocket_client

	INCPATHS += $(TOPDIR)/components/websocket_client/include
	INCPATHS += $(TOPDIR)/components/mbedtls/mbedtls/include/mbedtls
	INCPATHS += $(TOPDIR)/components/mbedtls/port/include/mbedtls
	INCPATHS += $(TOPDIR)/components/trs-tls
	INCPATHS += $(TOPDIR)/components/transport_tcp
	INCPATHS += $(TOPDIR)/components/http_client/libhttp/
endif
