ifeq ($(CONFIG_MQTT),y)
	INCPATHS += lwip/lwip-2.1.0/src/include/lwip
	INCPATHS += mbedtls/mbedtls/include
	

	CSRCS += mqtt_client.c \
			 mqtt_msg.c \
			 mqtt_outbox.c \
			 platform_tr6600.c

	ifeq ($(CONFIG_MQTT_PROTOCOL_5),y)
	CSRCS += mqtt5_client.c \
			 mqtt5_msg.c
	endif

	VPATH += :mqtt
	INCPATHS += mqtt
	INCPATHS += mqtt/include
endif
