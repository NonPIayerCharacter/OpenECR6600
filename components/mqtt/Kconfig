
menuconfig MQTT
	bool "MQTT Component Support"
	default n
	select TRANSPORT_TCP
	select MBEDTLS
	select URLPARSER

config MQTT_SSL
	bool "MQTT SSL Support"
	depends on MQTT
	default n

config MQTT_ENABLE_WS
	bool "MQTT ENABLE WS"
	depends on MQTT
	default n

config MQTT_ENABLE_WSS
	bool "MQTT ENABLE WSS"
	depends on MQTT
	default n

config MQTT_PROTOCOL_5
	bool "MQTT PROTOCOL 5 Support"
	depends on MQTT
	default n
